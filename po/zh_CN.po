#: src/window.c:240
msgid ""
"<b>精确触控板</b>\n"
"• 5 指多点触控\n"
"• 手势支持（滚动、缩放等）\n"
"• 触控报表率 ~100 Hz\n"
"• 压力感应反馈"
msgstr ""
"<b>精确触控板</b>\n"
"• 5 指多点触控\n"
"• 手势支持（滚动、缩放等）\n"
"• 触控报表率 ~100 Hz\n"
"• 压力感应反馈"

#: src/window.c:256
msgid ""
"<b>鼠标</b>\n"
"• 基础鼠标功能（光标移动 + 按键）\n"
"• 无多点触控，无手势\n"
"• 触控报表率降至 ~7 Hz\n"
"• 兼容旧系统"
msgstr ""
"<b>鼠标</b>\n"
"• 基础鼠标功能（光标移动 + 按键）\n"
"• 无多点触控，无手势\n"
"• 触控报表率降至 ~7 Hz\n"
"• 兼容旧系统"

